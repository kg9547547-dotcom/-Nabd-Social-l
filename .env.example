# ==========================================================
# نبض المجالس (Nabd Social Lounge) — Environment Variables
# ==========================================================
# Copy this file to `.env` for local development. On Render, set these
# under: Dashboard -> your service -> Environment.

# ---- Core ----
NODE_ENV="production"
# PORT is set automatically by Render — do not set it manually there.
# PORT=3000

# SESSION_SECRET: currently unused by the session mechanism itself (sessions are random
# 32-byte tokens stored in the database, not signed JWTs), but reserved for future use of
# cookie-parser's signed-cookie support. Set it anyway to a long random string.
SESSION_SECRET="change_this_to_a_long_random_secret_in_production"

# APP_URL: public URL this app is hosted at (used to pin Socket.IO CORS to a single origin).
APP_URL="https://your-app.onrender.com"

# GEMINI_API_KEY: required for Gemini AI API calls (@google/genai).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ---- PostgreSQL (primary persistence target) ----
# Provide DATABASE_URL (Render/Neon/Supabase all give you one) OR the discrete SQL_* vars below.
# DATABASE_URL takes priority when both are set.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Discrete alternative to DATABASE_URL (kept for backward compatibility):
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
# Set to "true" if your Postgres provider requires SSL and DATABASE_URL doesn't already
# indicate that (Neon/Supabase/Render internal Postgres already trigger this automatically).
PGSSL=""

# ---- SQLite (current live read/write store — see PRODUCTION_AUDIT.md) ----
# On Render's ephemeral disk this file is lost on every restart/redeploy; the app tries to
# restore it from the PostgreSQL snapshot / Firestore backup on boot. This is a stopgap, not
# a substitute for finishing the PostgreSQL migration described in PRODUCTION_AUDIT.md.
SQLITE_DB_PATH="./data/nabd_social.sqlite"

# ---- Media storage ----
# UPLOADS_DIR is only a local staging buffer; files are uploaded to Firebase Storage (see
# firebase-applet-config.json + Firebase Admin credentials below) and served from there.
UPLOADS_DIR="./uploads"

# Firebase Admin SDK service-account credentials — REQUIRED for both media storage
# (uploadBufferToFirebaseAdminStorage) and the Firestore backup/restore + mirroring
# (firestoreCloudBackup.ts), now that both use the Admin SDK instead of the public client SDK.
# Provide ONE of:
#   1) GOOGLE_APPLICATION_CREDENTIALS = path to a service-account JSON file, or
#   2) FIREBASE_SERVICE_ACCOUNT_JSON = the service-account JSON contents as a single-line string
# On Render, option 2 is usually easier: paste the JSON as a Secret File or env var and adapt
# src/lib/firebase-admin.ts to call `initializeApp({ credential: cert(JSON.parse(...)) })`.
GOOGLE_APPLICATION_CREDENTIALS=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ---- WebRTC (optional) ----
# STUN is public (Google's) and hardcoded in useWebRTCAudio.ts — no config needed.
# TURN is optional, only needed for strict symmetric-NAT/corporate-firewall users.
TURN_URL=""
TURN_USERNAME=""
TURN_PASSWORD=""

# ---- Optional sign-in providers (NOT required — registration stays Name+Username+Password) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
